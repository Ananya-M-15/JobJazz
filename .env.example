# JobJazz Application Configuration Example
# Copy this file to .env and configure secrets in your deployment environment.

APP_NAME=JobJazz
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database Connection (PostgreSQL)
# Local Docker default: postgresql://postgres:postgres@localhost:5432/jobjazz
# Production managed PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobjazz

# AI Integration
# Google Gemini API key (optional: deterministic fallbacks will be used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (comma-separated origins)
# In production, set to your frontend domain, e.g.: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Frontend Build-time Configuration (see frontend/.env.example)
# VITE_API_URL=http://localhost:8000
